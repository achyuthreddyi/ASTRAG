# Copy to .env and adjust. Defaults match docker-compose.yml.
ASTRAG_DATABASE_URL=postgresql+psycopg://astrag:astrag@localhost:5433/astrag
ASTRAG_ARTIFACT_STORE_ROOT=var/artifacts

# fake = deterministic offline embedder (tests, evaluation). openai = real.
ASTRAG_EMBEDDING_PROVIDER=fake
# ASTRAG_OPENAI_API_KEY=sk-...

# Nested settings use a double underscore:
# ASTRAG_CHUNKING__TARGET_TOKENS=512
